# IshemaLink Production Environment Variables
# Copy to .env and fill in real values — NEVER commit .env to Git

DEBUG=False
SECRET_KEY=your-secret-key-here-minimum-50-chars
ALLOWED_HOSTS=your-domain.rw,www.your-domain.rw

# PostgreSQL
DATABASE_URL=postgresql://ishemalink_user:ishemalink_pass@db:5432/ishemalink_db

# Redis
REDIS_URL=redis://redis:6379/0

# RRA & RURA API Keys
RRA_API_KEY=your-rra-api-key
RURA_API_KEY=your-rura-api-key

# MTN Momo
MOMO_API_KEY=your-momo-api-key
MOMO_WEBHOOK_SECRET=your-webhook-hmac-secret
